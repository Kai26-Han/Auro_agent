# 复制为 .env 后填写密钥；不要把密钥发到聊天或提交到 Git。
DEEPSEEK_API_KEY=
# 当前 DeepSeek 官方工具调用示例使用此模型；可改成账号支持的模型 ID。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
# 相对路径以本项目为基准。这里只接收 UTF-8 的 .md 和 .txt。
WORKBENCH_NOTES_DIR=notes
WORKBENCH_MAX_MODEL_CALLS=16
WORKBENCH_MAX_TOOL_CALLS=30
WORKBENCH_TIMEOUT_SECONDS=60
